resolve_id() { # resolve_id <n|b<n>|id> -> sets RESOLVED_ID; returns 1 on bad position.
  # NOTE: sets a global rather than echoing, so callers invoke it directly (not
  # in $(...)). exit inside a command substitution would only end the subshell.
  # `<n>` is a position in today's list, `b<n>` one in the backlog; anything
  # else is taken as an id. A 21-char nanoid that happens to be all digits (or
  # "b" + digits) would be misread, which is not worth guarding at ~1e-17 odds.
  local arg="$1" path="/api/todos" pos="$1" what="today's list"
  case "$arg" in
    b*)
      pos="${arg#b}"
      case "$pos" in
        ''|*[!0-9]*) RESOLVED_ID="$arg"; return 0 ;;  # not b<n>: an id
      esac
      path="/api/todos/backlog"; what="the backlog" ;;
    ''|*[!0-9]*) RESOLVED_ID="$arg"; return 0 ;;  # non-numeric = id
  esac
  api GET "$path"; api_ok_or_die
  local id
  id=$(printf '%s' "$BODY" | python3 -c '
import json, sys
d = json.load(sys.stdin); n = int(sys.argv[1]); ts = d["todos"]
print(ts[n-1]["id"] if 1 <= n <= len(ts) else "")' "$pos")
  if [ -z "$id" ]; then
    echo "${PROG}: no todo at position $arg in $what" >&2
    return 1
  fi
  RESOLVED_ID="$id"
  return 0
}

resolve_pid() { # resolve_pid <p<n>|id> -> sets RESOLVED_PID/PLABEL/PTITLE/PROW.
  # Same "sets globals, never echoes" contract as resolve_id, and for the same
  # reason: exit inside a command substitution only ends the subshell.
  #
  # `p<n>` is a position in the UNFILTERED /api/projects order, not in the list
  # as printed -- so a p7 seen under `--status someday` is still p7 here. That
  # is the one deliberate departure from <n>/b<n> (docs/spec/dyd-cli.md), and
  # it is why every projects view numbers from the same read.
  #
  # The list is fetched even for a raw id, because every project verb's output
  # line needs the title anyway -- and RESOLVED_PROW carries the whole row, so
  # `show` does not need a per-project read (the API exposes no
  # GET /api/projects/:id; one id is reached through the list). An id the list
  # does not carry is passed through so the API answers with its own 404, same
  # tolerance as resolve_id.
  local arg="$1" pos=""
  case "$arg" in
    p*)
      pos="${arg#p}"
      case "$pos" in
        ''|*[!0-9]*) pos="" ;;  # not p<n>: an id that happens to start with p
      esac ;;
  esac
  api GET /api/projects; api_ok_or_die
  { read -r RESOLVED_PID; read -r RESOLVED_PLABEL; read -r RESOLVED_PTITLE
    read -r RESOLVED_PROW; } < <(
    printf '%s' "$BODY" | python3 -c '
import json, sys
ps = json.load(sys.stdin)["projects"]
arg, pos = sys.argv[1], sys.argv[2]
if pos:
    n = int(pos)
    p = ps[n - 1] if 1 <= n <= len(ps) else None
else:
    p = next((x for x in ps if x["id"] == arg), None)
    n = (ps.index(p) + 1) if p else 0
if p is None:
    # A bad p<n> is a client-side error; an unknown id goes to the API.
    print("" if pos else arg); print(""); print(""); print("null")
else:
    # The shell reads these as exactly four lines, so none may span two:
    # json.dumps escapes the row, and the title -- which may carry interior
    # newlines (normalizeName only edge-trims) -- is flattened for display.
    # The exact title still reaches every formatter inside the row.
    print(p["id"]); print(f"p{n}"); print(" ".join(p["title"].splitlines())); print(json.dumps(p))' "$arg" "$pos"
  )
  if [ -z "$RESOLVED_PID" ]; then
    echo "${PROG}: no project at position $arg" >&2
    return 1
  fi
  [ -n "$RESOLVED_PLABEL" ] || RESOLVED_PLABEL="$arg"
  return 0
}

