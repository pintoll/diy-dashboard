      api PATCH "/api/todos/$RESOLVED_ID" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt todo_line "$BODY" "done:" ;;
    use)
      # Add to the desk (additive); `use -` clears the whole desk.
      [ $# -eq 1 ] || die_usage
      if [ "$1" = "-" ]; then
        api DELETE /api/desk
      else
        resolve_id "$1" || exit 1
        api POST /api/desk "$(printf '{"id":"%s"}' "$RESOLVED_ID")"
      fi
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt desk_set "$BODY" ;;
    drop)
      # Remove a single member from the desk.
      [ $# -eq 1 ] || die_usage
      resolve_id "$1" || exit 1
      api DELETE "/api/desk/$RESOLVED_ID"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt desk_set "$BODY" ;;
    *) die_usage ;;
  esac
}

# The day record: plan + fold state for one day (GET /api/days/:day). Titles
# for unfolded plan entries come from /api/todos/by-ids; a folded day carries
# its own denormalized titles in the snapshot.
# The steering layer (docs/design/projects-para.md). Nothing here executes work:
# the only path from a project into doing is `pull`, which is an ordinary
# PATCH /api/todos/:id with a date. That is why there is no start/plan/timer
# verb, and why there should never be one.
cmd_projects() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  case "$sub" in
    list)
      local want="" stale_only=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --status) [ $# -ge 2 ] || die_usage; want="$2"; shift 2 ;;
          --stale) stale_only=1; shift ;;
          *) die_usage ;;
        esac
      done
      # --json keeps the four-read contract, backlog body included, for
      # callers that parse it.
      if [ "$JSON_OUT" = 1 ]; then
        api_get_all /api/projects /api/projects/stats /api/todos/backlog /api/today
        par_ok_or_die
        python3 -c '
import json, sys
def load(s):
    s=(s or "").strip(); return json.loads(s) if s else None
print(json.dumps({
  "projects": load(sys.argv[1]),
  "stats": load(sys.argv[2]),
  "backlog": load(sys.argv[3]),
  "today": load(sys.argv[4]),
}))' "${PAR_BODY[0]}" "${PAR_BODY[1]}" "${PAR_BODY[2]}" "${PAR_BODY[3]}"
        return
      fi
      # One screen, one round trip: the list names them, stats carries every
      # number AND the inbox badge (inboxCount), and /api/today is the day the
      # ages are measured against (never this machine's). No backlog fetch:
      # this is the layer's hottest read and the warehouse grows without bound.
      api_get_all /api/projects /api/projects/stats /api/today
      par_ok_or_die
      fmt projects "${PAR_BODY[0]}" "${PAR_BODY[1]}" \
        "$(jget "${PAR_BODY[2]}" 'd["date"]')" "$want" "$stale_only" ;;
    show)
      [ $# -ge 1 ] && [ $# -le 3 ] || die_usage
      local target="$1"; shift
      local doc="notes"
      while [ $# -gt 0 ]; do
        case "$1" in
          --doc) [ $# -ge 2 ] || die_usage; doc="$2"; shift 2 ;;
          *) die_usage ;;
        esac
      done
      resolve_pid "$target" || exit 1
      local prow="{\"project\":$RESOLVED_PROW}"
      api_get_all "/api/projects/$(urlenc "$RESOLVED_PID")/todos" \
        "/api/projects/$(urlenc "$RESOLVED_PID")/docs" /api/projects/stats /api/today
      par_ok_or_die
      if [ "$JSON_OUT" = 1 ]; then
        python3 -c '
import json, sys
def load(s):
    s=(s or "").strip(); return json.loads(s) if s else None
print(json.dumps({
  "project": load(sys.argv[1]),
  "todos": load(sys.argv[2]),
  "docs": load(sys.argv[3]),
  "stats": load(sys.argv[4]),
}))' "$RESOLVED_PROW" "${PAR_BODY[0]}" "${PAR_BODY[1]}" "${PAR_BODY[2]}"
        return
      fi
      fmt project_show "$prow" "${PAR_BODY[0]}" "${PAR_BODY[1]}" "${PAR_BODY[2]}" \
        "$(jget "${PAR_BODY[3]}" 'd["date"]')" "$RESOLVED_PLABEL" "$doc" ;;
    add)
      [ $# -ge 1 ] || die_usage
      local title="$1"; shift
      local kind="" outcome="" outcome_set=0 target="" target_set=0
      local status="" reason="" reason_set=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --kind) kind="${2:-}"; shift 2 || die_usage ;;
          --outcome) outcome="${2:-}"; outcome_set=1; shift 2 || die_usage ;;
          --target) target="${2:-}"; target_set=1; shift 2 || die_usage ;;
          --someday) status="someday"; shift ;;
          --reason) reason="${2:-}"; reason_set=1; shift 2 || die_usage ;;
          *) die_usage ;;
        esac
      done
      local body
      body=$(TITLE="$title" KIND="$kind" OUTCOME="$outcome" OUTCOME_SET="$outcome_set" \
             TARGET="$target" TARGET_SET="$target_set" STATUS="$status" \
             REASON="$reason" REASON_SET="$reason_set" python3 -c '
import json, os
out = {"title": os.environ["TITLE"]}
if os.environ["KIND"]:
    out["kind"] = os.environ["KIND"]
if os.environ["STATUS"]:
    out["status"] = os.environ["STATUS"]
# An empty --outcome/--target sends null (clear), like dyd fold --remarks "".
if os.environ["OUTCOME_SET"] == "1":
    out["outcome"] = os.environ["OUTCOME"] or None
if os.environ["TARGET_SET"] == "1":
    out["targetDate"] = os.environ["TARGET"] or None
if os.environ["REASON_SET"] == "1":
    out["reason"] = os.environ["REASON"]
print(json.dumps(out))')
      api POST /api/projects "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die
      local new_id; new_id=$(jget "$BODY" 'd["project"]["id"]')
      # Refetch so the created project prints with its p<n>, the handle every
      # other verb takes. Same shape as `dyd todo add`.
      api GET /api/projects; api_ok_or_die
      fmt project_added "$BODY" "$new_id" ;;
    set)
      [ $# -ge 3 ] || die_usage
      local target_p="$1"; shift
      local title="" title_set=0 outcome="" outcome_set=0 tdate="" tdate_set=0
      local kind="" reason="" reason_set=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --title) title="${2:-}"; title_set=1; shift 2 || die_usage ;;
          --outcome) outcome="${2:-}"; outcome_set=1; shift 2 || die_usage ;;
          --target) tdate="${2:-}"; tdate_set=1; shift 2 || die_usage ;;
          --kind) kind="${2:-}"; shift 2 || die_usage ;;
          --reason) reason="${2:-}"; reason_set=1; shift 2 || die_usage ;;
          *) die_usage ;;
        esac
      done
      # No field at all would be a 400 anyway; fail before the round trip.
      [ "$title_set$outcome_set$tdate_set" = "000" ] && [ -z "$kind" ] && die_usage
      resolve_pid "$target_p" || exit 1
      local body
      body=$(TITLE="$title" TITLE_SET="$title_set" OUTCOME="$outcome" \
             OUTCOME_SET="$outcome_set" TARGET="$tdate" TARGET_SET="$tdate_set" \
             KIND="$kind" REASON="$reason" REASON_SET="$reason_set" python3 -c '
import json, os
out = {}
if os.environ["TITLE_SET"] == "1":
    out["title"] = os.environ["TITLE"]
if os.environ["OUTCOME_SET"] == "1":
    out["outcome"] = os.environ["OUTCOME"] or None
if os.environ["TARGET_SET"] == "1":
    out["targetDate"] = os.environ["TARGET"] or None
if os.environ["KIND"]:
    out["kind"] = os.environ["KIND"]
if os.environ["REASON_SET"] == "1":
    out["reason"] = os.environ["REASON"]
print(json.dumps(out))')
      api PATCH "/api/projects/$(urlenc "$RESOLVED_PID")" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt project_line "$BODY" "updated" ;;
    activate|someday|done|archive)
      # Four verbs, one PATCH: a review speaks them as verbs ("demote to
      # someday", "archive it"), the way `dyd source enable|disable` does.
      [ $# -ge 1 ] || die_usage
      local target_p="$1"; shift
      local reason="" reason_set=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --reason) reason="${2:-}"; reason_set=1; shift 2 || die_usage ;;
          *) die_usage ;;
        esac
      done
      local status="$sub" lead="$sub"
      case "$sub" in
        activate) status="active"; lead="activated" ;;
        archive) status="archived"; lead="archived" ;;
        someday) lead="parked" ;;
        done) lead="done" ;;
      esac
      resolve_pid "$target_p" || exit 1
      local body
      body=$(STATUS="$status" REASON="$reason" REASON_SET="$reason_set" python3 -c '
import json, os
out = {"status": os.environ["STATUS"]}
if os.environ["REASON_SET"] == "1":
    out["reason"] = os.environ["REASON"]
print(json.dumps(out))')
      api PATCH "/api/projects/$(urlenc "$RESOLVED_PID")" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt project_line "$BODY" "$lead" ;;
    note|notes)
      [ $# -ge 1 ] || die_usage
      local target_p="$1"; shift
      local line="" doc="notes" raw=0 reason="" reason_set=0
      if [ "$sub" = "note" ]; then
        [ $# -ge 1 ] || die_usage
        line="$1"; shift
      fi
      while [ $# -gt 0 ]; do
        case "$1" in
          --doc) [ $# -ge 2 ] || die_usage; doc="$2"; shift 2 ;;
          --raw) raw=1; shift ;;
          --reason) reason="${2:-}"; reason_set=1; shift 2 || die_usage ;;
          *) die_usage ;;
        esac
      done
      resolve_pid "$target_p" || exit 1
      api GET "/api/projects/$(urlenc "$RESOLVED_PID")/docs"; api_ok_or_die
      local docs_body="$BODY" doc_id
      doc_id=$(DOC="$doc" python3 -c '
import json, os, sys
d = json.load(sys.stdin)["docs"]
want = os.environ["DOC"]
print(next((x["id"] for x in d if x["title"] == want), ""))' <<< "$docs_body")
      if [ -z "$doc_id" ]; then
        echo "${PROG}: no doc titled \"$doc\" on $RESOLVED_PTITLE" >&2
        exit 1
      fi
      if [ "$sub" = "notes" ]; then
        local one
        one=$(DOC_ID="$doc_id" python3 -c '
import json, os, sys
d = json.load(sys.stdin)["docs"]
print(json.dumps({"doc": next(x for x in d if x["id"] == os.environ["DOC_ID"])}))' <<< "$docs_body")
        if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$one"; return; fi
        fmt project_doc "$one" "$RESOLVED_PTITLE"
        return
      fi
      # Dated by default: the server does not date an append, and the date must
      # be the app's 05:00 day, so only the CLI can put it there. --raw opts out.
      local prefix=""
      if [ "$raw" = 0 ]; then
        local today; today=$(app_today) || exit
        prefix="$today: "
      fi
      local body
      body=$(LINE="${prefix}${line}" REASON="$reason" REASON_SET="$reason_set" python3 -c '
import json, os
out = {"append": os.environ["LINE"]}
if os.environ["REASON_SET"] == "1":
    out["reason"] = os.environ["REASON"]
print(json.dumps(out))')
      api PATCH "/api/docs/$(urlenc "$doc_id")" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt project_noted "$BODY" "$RESOLVED_PTITLE" ;;
    file)
      [ $# -ge 2 ] || die_usage
      local todo_arg="$1" proj_arg="$2"; shift 2
      local reason="" reason_set=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --reason) reason="${2:-}"; reason_set=1; shift 2 || die_usage ;;
          *) die_usage ;;
        esac
      done
      resolve_id "$todo_arg" || exit 1
      local todo_id="$RESOLVED_ID" pid="" label="(inbox)"
      if [ "$proj_arg" != "-" ]; then
        resolve_pid "$proj_arg" || exit 1
        pid="$RESOLVED_PID"; label="$RESOLVED_PTITLE"
      fi
      local body
      body=$(PID="$pid" REASON="$reason" REASON_SET="$reason_set" python3 -c '
import json, os
out = {"projectId": os.environ["PID"] or None}
if os.environ["REASON_SET"] == "1":
    out["reason"] = os.environ["REASON"]
print(json.dumps(out))')
      api PATCH "/api/todos/$(urlenc "$todo_id")" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt project_todo "$BODY" "filed" "$label" ;;
    pull)
      [ $# -ge 1 ] || die_usage
      local target_p="$1"; shift
      local k=1 dspec="today" reason="" reason_set=0
      case "${1:-}" in
        ''|-*) ;;
        *) k="$1"; shift ;;
      esac
      while [ $# -gt 0 ]; do
        case "$1" in
          -d) [ $# -ge 2 ] || die_usage; dspec="$2"; shift 2 ;;
          --reason) reason="${2:-}"; reason_set=1; shift 2 || die_usage ;;
          *) die_usage ;;
        esac
      done
      case "$k" in ''|*[!0-9]*) die_usage ;; esac
      resolve_pid "$target_p" || exit 1
      api GET "/api/projects/$(urlenc "$RESOLVED_PID")/todos"; api_ok_or_die
      local todo_id
      todo_id=$(printf '%s' "$BODY" | python3 -c '
import json, sys
b = json.load(sys.stdin)["backlog"]; n = int(sys.argv[1])
print(b[n - 1]["id"] if 1 <= n <= len(b) else "")' "$k")
      if [ -z "$todo_id" ]; then
        echo "${PROG}: no backlog item $k in $RESOLVED_PTITLE" >&2
        exit 1
      fi
      local datejson; datejson=$(date_json "$dspec") || exit
      local body
      body=$(DATE="$datejson" REASON="$reason" REASON_SET="$reason_set" python3 -c '
import json, os
out = {"date": json.loads(os.environ["DATE"])}
if os.environ["REASON_SET"] == "1":
    out["reason"] = os.environ["REASON"]
print(json.dumps(out))')
      api PATCH "/api/todos/$(urlenc "$todo_id")" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die
      fmt project_todo "$BODY" "pulled" "$(jget "$BODY" 'd["todo"]["date"] or "backlog"')" ;;
    *) die_usage ;;
  esac
}

cmd_day() {
  [ $# -le 1 ] || die_usage
  local day
  day=$(day_spec "${1:-today}") || exit
  api GET "/api/days/$day"
  if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
  api_ok_or_die
  local day_body="$BODY" ids todos_body='{"todos":[]}'
  ids=$(jget "$day_body" '",".join(sorted({e["todoId"] for e in d["plan"]}))')
  if [ -n "$ids" ]; then
    api GET "/api/todos/by-ids?ids=$ids"; api_ok_or_die
    todos_body="$BODY"
  fi
  fmt day "$day_body" "$todos_body"
}

# The assistant's "yesterday": the last day with records after the last fold
# (GET /api/yesterday) — the day a morning session offers to fold. Distinct
# from `dyd log yesterday`, which is plain calendar arithmetic on today.
cmd_yesterday() {
  [ $# -eq 0 ] || die_usage
  api GET /api/yesterday
  if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
  api_ok_or_die; fmt yesterday "$BODY"
}

# Close a day (POST /api/days/:day/fold). With no day named, folds the pending
# day the resolver reports — the lazy morning-fold path; `dyd fold today` is
# the night-close path. Idempotent per the API: re-folding recomputes.
cmd_fold() {
  local day="" remarks="" remarks_set=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --remarks) remarks="${2:-}"; remarks_set=1; shift 2 || die_usage ;;
      -*) die_usage ;;
      *) [ -n "$day" ] && die_usage; day="$1"; shift ;;
    esac
  done
  if [ -z "$day" ]; then
    api GET /api/yesterday; api_ok_or_die
    day=$(jget "$BODY" 'd["date"] or ""')
    if [ -z "$day" ]; then
      echo "${PROG}: nothing to fold (all days folded)" >&2
      exit 1
    fi
  else
    day=$(day_spec "$day") || exit
  fi
  local body="{}"
  if [ "$remarks_set" = 1 ]; then
    # An empty --remarks sends null, which clears any stored remarks.
    body=$(REMARKS="$remarks" python3 -c '
import json, os
print(json.dumps({"remarks": os.environ["REMARKS"] or None}))')
  fi
  api POST "/api/days/$day/fold" "$body"
  if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
  api_ok_or_die; fmt folded "$BODY"
}

# One intent as an atomic batch (POST /api/apply): a required reason, an
# optional sessionId, and ops that may reference earlier creates as "$N".
# Spec: docs/spec/todos-agent-api.md.
cmd_apply() {
  [ $# -eq 1 ] || die_usage
  local body; body=$(json_arg "$1") || exit 1
  api POST /api/apply "$body"
  if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
  api_ok_or_die; fmt applied "$BODY" "$body"
}

# Data-source connectors. Writes go through the API's dry-run: the app fetches
# the definition for real before storing it, so `add`/`patch` can take a few
# seconds and a bad path comes back as an error instead of a silent dud card.
cmd_source() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  case "$sub" in
    list)
      local qs=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --group) [ $# -ge 2 ] || die_usage; qs="$qs&group=$(urlenc "$2")"; shift 2 ;;
          --kind) [ $# -ge 2 ] || die_usage; qs="$qs&kind=$(urlenc "$2")"; shift 2 ;;
          *) die_usage ;;
        esac
      done
      local path="/api/connectors"
      [ -n "$qs" ] && path="$path?${qs#&}"
      api GET "$path"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt sources "$BODY" ;;
    show)
      [ $# -eq 1 ] || die_usage
      api GET "/api/connectors/$1"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt source_show "$BODY" ;;
    add)
      [ $# -eq 1 ] || die_usage
      local body; body=$(json_arg "$1") || exit 1
      api POST /api/connectors "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt source_write "$BODY" ;;
    patch)
      [ $# -eq 2 ] || die_usage
      local body; body=$(json_arg "$2") || exit 1
      api PATCH "/api/connectors/$1" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt source_write "$BODY" ;;
    rm)
      [ $# -eq 1 ] || die_usage
      api DELETE "/api/connectors/$1"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; echo "removed  $1" ;;
    test)
      [ $# -eq 1 ] || die_usage
      api POST "/api/connectors/$1/test"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die
      fmt test_result "$BODY"
      # A reachable app that fetched a broken source is HTTP 200 with ok:false.
      # Exit 1 anyway: the verdict is the whole reason to run this command.
      [ "$(jget "$BODY" 'd["test"]["ok"]')" = "True" ] || exit 1 ;;
    enable|disable)
      [ $# -eq 1 ] || die_usage
      local body='{"enabled":true}'
      [ "$sub" = "disable" ] && body='{"enabled":false}'
      # No skipTest either way: the server treats an enabled-only patch as a
      # state flip and does not dry-run it. So a broken source can still be
      # switched off, and one can be switched back on before its key is set.
      api PATCH "/api/connectors/$1" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt source_write "$BODY" ;;
    *) die_usage ;;
  esac
}

# Credentials are write-only: the API returns names and pinned hosts, never a
# secret, so there is no `cred show`.
cmd_cred() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  case "$sub" in
    list)
      [ $# -eq 0 ] || die_usage
      api GET /api/credentials
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt creds "$BODY" ;;
    set)
      [ $# -eq 3 ] || die_usage
      local body
      body=$(HOST="$2" SECRET="$3" python3 -c '
import json, os
print(json.dumps({"allowedHost": os.environ["HOST"], "secret": os.environ["SECRET"]}))')
      api PUT "/api/credentials/$1" "$body"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; fmt cred_set "$BODY" ;;
    rm)
      [ $# -eq 1 ] || die_usage
      api DELETE "/api/credentials/$1"
      if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$BODY"; api_ok_or_die; return; fi
      api_ok_or_die; echo "removed  $1" ;;
    *) die_usage ;;
  esac
}

if [ $# -eq 0 ]; then
  cmd_overview
  exit 0
fi

top="$1"; shift
case "$top" in
  pomo) cmd_pomo "$@" ;;
