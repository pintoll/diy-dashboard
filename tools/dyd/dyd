#!/usr/bin/env bash
# dyd — terminal CLI for diy-dashboard (pomodoro + today's todos).
# Spec: docs/spec/dyd-cli.md. Talks only to the loopback agent API; remote
# access is SSH's job. No build step: bash + python3 + curl (or curl.exe).
set -o pipefail

PROG="dyd"

die_usage() {
  cat >&2 <<'USAGE'
usage:
  dyd                         overview (pomodoro + today + overdue count)
  dyd pomo                    pomodoro status
  dyd pomo <start|pause|stop|skip|reset>
  dyd pomo set <25:5|50:10|100:20|120:30>
  dyd todo                    today's list
  dyd todo overdue            overdue list
  dyd todo backlog            backlog (todos with no planned day)
  dyd todo add "<title>" [-d <date|today|tomorrow|backlog>] [-n <note>] [--reason <text>]
  dyd todo done <n|id> [--reason <text>]
  dyd todo move <n|id|b<n>> <date|today|tomorrow|backlog> [--reason <text>]
  dyd todo use <n|id|->       add a todo to the desk (- clears the desk)
  dyd todo drop <n|id>        remove a todo from the desk
  dyd projects                the steering glance: progress, next action, stale mark
  dyd projects list [--status <active|someday|done|archived|all>] [--stale]
  dyd projects show <p<n>|id>
  dyd projects add "<title>" [--kind <project|area>] [--outcome <t>] [--target <date>] [--someday] [--reason <text>]
  dyd projects set <p<n>|id> [--title <t>] [--outcome <t>] [--target <date>] [--kind <k>] [--reason <text>]
  dyd projects <activate|someday|done|archive> <p<n>|id> [--reason <text>]
  dyd projects note <p<n>|id> "<line>" [--doc <title>] [--raw] [--reason <text>]
  dyd projects notes <p<n>|id> [--doc <title>]   read a project doc
  dyd projects file <n|id|b<n>> <p<n>|id|->      file a todo under a project (- unfiles)
  dyd projects pull <p<n>|id> [<k>] [-d <date>] [--reason <text>]   next action -> a day
  dyd log [date|today|yesterday]  a day's journal, rendered
  dyd day [date|today|yesterday]  a day's record: plan + fold state
  dyd yesterday               the unfolded day pending a fold, if any
  dyd fold [date|today|yesterday] [--remarks <text>]  close a day (default: the pending day)
  dyd apply <json>            one intent as an atomic batch:
                              {"reason":"...","sessionId"?,"ops":[...]}
  dyd source                  list data-source connectors
  dyd source list [--group <g>] [--kind <series|events>]
  dyd source show <id>
  dyd source add <json>       add a connector; the app fetches it before saving
  dyd source patch <id> <json>
  dyd source rm <id>
  dyd source test <id>        fetch a stored connector now, print a sample
  dyd source enable <id> | disable <id>
  dyd cred                    list credential names and their pinned hosts
  dyd cred set <name> <host> <secret>
  dyd cred rm <name>
  global: --json              print the raw API response body
USAGE
  exit 1
}

not_running() {
  echo "diy-dashboard is not running" >&2
  exit 2
}

# --- connection resolution -------------------------------------------------
resolve_conn() {
  if [ -n "${DYD_API_FILE:-}" ]; then
    API_FILE="$DYD_API_FILE"
    case "$API_FILE" in
      /mnt/*) CURL="curl.exe" ;;
      *) CURL="curl" ;;
    esac
  else
    local win
    win=$(ls /mnt/c/Users/*/AppData/Roaming/diy-dashboard/agent-api.json 2>/dev/null | head -1)
    if [ -n "$win" ]; then
      API_FILE="$win"; CURL="curl.exe"
    elif [ -f "$HOME/.config/diy-dashboard/agent-api.json" ]; then
      API_FILE="$HOME/.config/diy-dashboard/agent-api.json"; CURL="curl"
    fi
  fi
  if [ -z "${API_FILE:-}" ] || [ ! -f "$API_FILE" ]; then
    not_running
  fi
  { read -r PORT; read -r TOKEN; } < <(python3 - "$API_FILE" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d["port"]); print(d["token"])
except Exception:
    pass
PY
)
  [ -n "${PORT:-}" ] && [ -n "${TOKEN:-}" ] || not_running
}

# --- request helper --------------------------------------------------------
# api METHOD PATH [JSON_BODY] -> sets BODY and HTTP_STATUS; exits 2 on refusal.
api() {
  local method="$1" path="$2" body="${3:-}"
  local args=(-s -S -o - -w '\n%{http_code}' -X "$method"
    -H "Authorization: Bearer $TOKEN")
  if [ -n "$body" ]; then
    args+=(-H "Content-Type: application/json" -d "$body")
  fi
  local resp
  resp=$("$CURL" "${args[@]}" "http://127.0.0.1:$PORT$path" 2>/dev/null)
  if [ $? -ne 0 ]; then
    not_running
  fi
  HTTP_STATUS="${resp##*$'\n'}"
  BODY="${resp%$'\n'*}"
}

# api_get_all PATH... -> fills PAR_BODY / PAR_STATUS, one entry per path, in
# argument order. The requests are issued concurrently, so a view built from
# several independent reads costs one round trip of latency instead of N.
# Validation is left to the caller (assign HTTP_STATUS/BODY, call
# api_ok_or_die), because tolerance differs per endpoint.
api_get_all() {
  local dir path i=0 pid failed=0 resp
  local pids=()
  dir=$(mktemp -d) || not_running
  for path in "$@"; do
    "$CURL" -s -S -o - -w '\n%{http_code}' -X GET \
      -H "Authorization: Bearer $TOKEN" \
      "http://127.0.0.1:$PORT$path" > "$dir/$i" 2>/dev/null &
    pids+=("$!")
    i=$((i + 1))
  done
  for pid in "${pids[@]}"; do
    wait "$pid" || failed=1
  done
  PAR_BODY=(); PAR_STATUS=()
  i=0
  for path in "$@"; do
    resp=$(cat "$dir/$i" 2>/dev/null)
    PAR_STATUS+=("${resp##*$'\n'}")
    PAR_BODY+=("${resp%$'\n'*}")
    i=$((i + 1))
  done
  rm -rf "$dir"
  [ "$failed" = 0 ] || not_running
}

api_ok_or_die() {
  case "$HTTP_STATUS" in
    2*) return 0 ;;
    *)
      local msg
      msg=$(printf '%s' "$BODY" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error",""))
except Exception: print("")' 2>/dev/null)
      echo "${PROG}: error: ${msg:-HTTP $HTTP_STATUS}" >&2
      exit 1 ;;
  esac
}

# Validates every api_get_all response, in argument order: each one is loaded
# into HTTP_STATUS/BODY and run through api_ok_or_die, so a failure dies with
# that response's own error message. A view that tolerates one endpoint
# failing (the overview's pomodoro read) keeps its hand-rolled loop instead.
par_ok_or_die() {
  local i
  for (( i = 0; i < ${#PAR_STATUS[@]}; i++ )); do
    HTTP_STATUS="${PAR_STATUS[$i]}"; BODY="${PAR_BODY[$i]}"; api_ok_or_die
  done
}

jget() { # jget JSON 'python-expr on d'
  printf '%s' "$1" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(eval(sys.argv[1]))' "$2"
}

json_arg() { # json_arg <text> -> compact JSON on stdout; 1 + message on a syntax error
  # Connector definitions are typed or pasted by hand, so a stray comma is the
  # likeliest failure. Catch it here where the caret position is still useful,
  # rather than shipping it as a bare "not valid JSON" 400.
  local out
  out=$(printf '%s' "$1" | python3 -c '
import json, sys
try:
    print(json.dumps(json.load(sys.stdin)))
except Exception as e:
    print(e, file=sys.stderr); sys.exit(1)' 2>&1) || {
    echo "${PROG}: error: argument is not valid JSON (${out})" >&2
    return 1
  }
  printf '%s' "$out"
}

urlenc() { # group names are free-form and may contain spaces
  printf '%s' "$1" | python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.stdin.read(), safe=""))'
}

# app_today -> the app's current day (yyyy-MM-dd) on stdout. The app's day
# runs 05:00->05:00 Asia/Seoul (src/shared/day.ts), so this machine's calendar
# date is one day ahead of it between midnight and 05:00 — "today" is the
# server's call, never computed locally. Callers run this in $(...), so an
# error exits only the subshell; propagate with `|| exit`.
app_today() {
  api GET /api/today; api_ok_or_die
  jget "$BODY" 'd["date"]'
}

# date_json <today|tomorrow|backlog|YYYY-MM-DD> -> the JSON value for a body's
# "date" field. `backlog` is null on the wire, not a magic string; `today` and
# `tomorrow` are the app's 05:00-bounded day (via app_today), not this
# machine's; an unknown spec is passed through verbatim so the API rejects it
# with a useful message. Same subshell caveat as app_today: `|| exit`.
date_json() {
  local spec today
  spec=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$spec" in
    backlog)
      printf 'null\n' ;;
    today|tomorrow)
      today=$(app_today) || exit
      SPEC="$spec" TODAY="$today" python3 -c '
import json, os
from datetime import date, timedelta
d = date.fromisoformat(os.environ["TODAY"])
if os.environ["SPEC"] == "tomorrow":
    d += timedelta(days=1)
print(json.dumps(str(d)))' ;;
    *)
      SPEC="$1" python3 -c 'import json, os; print(json.dumps(os.environ["SPEC"]))' ;;
  esac
}

# day_spec <today|yesterday|YYYY-MM-DD> -> a urlencoded day for the /api/days
# routes. One resolver for every command that names a day (log, day, fold), so
# a spelling accepted by one is accepted by all. `today` and `yesterday` are
# the app's 05:00-bounded day and the calendar day before it — arithmetic on
# the server's day, never this machine's clock. Deliberately NOT the same
# "yesterday" as the `dyd yesterday` command, which asks the resolver for the
# last unfolded day with records (/api/yesterday); `dyd fold` with no day is
# that path. An unknown spec passes through verbatim so the API rejects it with
# a useful message, same policy as date_json. Same subshell caveat as
# app_today: callers propagate with `|| exit`.
day_spec() {
  local spec today
  spec=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$spec" in
    today)
      app_today ;;
    yesterday)
      today=$(app_today) || exit
      TODAY="$today" python3 -c '
import os
from datetime import date, timedelta
print(date.fromisoformat(os.environ["TODAY"]) - timedelta(days=1))' ;;
    *)
      urlenc "$1" ;;
  esac
}

# --- formatter (all human output) -----------------------------------------
FORMATTER=$(cat <<'PY'
import json, sys
from datetime import date

def load(s):
    s = (s or "").strip()
    return json.loads(s) if s else None

def mmss(sec):
    sec = int(sec)
    sign = "-" if sec < 0 else ""
    sec = abs(sec)
    return f"{sign}{sec//60:02d}:{sec%60:02d}"

def worked(sec):
    sec = int(sec)
    return f"{sec//60}m" if sec >= 60 else ""

# worked() prints raw minutes, which stops reading at project scale (260m).
def hours(sec):
    sec = int(sec or 0)
    if sec < 60:
        return ""
    m = sec // 60
    return f"{m}m" if m < 60 else f"{m//60}h{m%60:02d}m"

# How long ago a day was, against the app's day (never this machine's clock).
def days_since(day, today):
    if not day:
        return "never"
    n = (date.fromisoformat(today) - date.fromisoformat(day)).days
    if n <= 0:
        return "today"
    return f"{n}d"

def progress(st):
    return f"{st.get('done', 0)}/{st.get('total', 0)}"

# Two lines per project: the title ends line 1 so a Korean title cannot skew a
# column (f-string padding counts codepoints, not display width), and every
# padded column on line 2 is ASCII. `isStale` comes from the API, which owns
# the day the rule turns on -- the CLI never re-derives it.
def project_rows(ps, stats, today):
    for p in ps:
        st = stats.get(p["id"], {})
        mark = "!" if st.get("isStale") else " "
        print(f"{mark} p{p['_n']} {p['title']}")
        nxt = st.get("nextAction")
        arrow = nxt["title"] if nxt else "(no next action)"
        print(f"     {progress(st):<7} {hours(st.get('workedSec')):<7} "
              f"{days_since(st.get('lastActivityDay'), today):<6} -> {arrow}")

# p<n> is a GLOBAL handle: the position in the unfiltered /api/projects order,
# stamped once here so filtering a view never renumbers it. This is the one
# deliberate departure from <n>/b<n>, which are positions in the list as
# printed (docs/spec/dyd-cli.md).
def numbered(projects):
    for i, p in enumerate(projects, 1):
        p["_n"] = i
    return projects

PHASE = {"work": "work", "shortBreak": "break", "longBreak": "long break"}
def phase_label(p): return PHASE.get(p, p)

def status_word(s):
    if s["overtime"]: return "overtime"
    if s["isRunning"]: return "running"
    if s["remainingSec"] < s["phaseDurationSec"]: return "paused"
    return "idle"

def pomo_line(p):
    if p is None:
        return "pomodoro: unavailable (no widget?)"
    ph = phase_label(p["phase"]); preset = p["presetId"]; done = p["completedPomodoros"]
    ot = p["overtime"]
    if ot:
        return f"{ph} +{mmss(ot['elapsedSec'])} overtime  ({preset}, #{done})"
    return f"{ph} {mmss(p['remainingSec'])} / {mmss(p['phaseDurationSec'])}  {status_word(p)}   ({preset}, #{done})"

def compact(s):
    ph = phase_label(s["phase"])
    if s["overtime"]:
        return f"⏱ {ph} +{mmss(s['overtime']['elapsedSec'])} overtime"
    st = status_word(s)
    sym = {"running": "▶", "paused": "⏸", "idle": "■"}.get(st, "■")
    return f"{sym} {ph} {mmss(s['remainingSec'])} {st}"

# Connector definitions name a credential; they never carry the secret, so there
# is nothing to redact here.
def auth_label(a):
    m = a["mode"]
    if m == "none":
        return "none"
    if m == "query":
        return f"query param {a['param']} (credential {a['credential']})"
    if m == "bearer":
        return f"bearer (credential {a['credential']})"
    if m == "header":
        return f"header {a['header']} (credential {a['credential']})"
    return m

def sample_lines(t, indent):
    for s in (t.get("sample") or []):
        v = s.get("value")
        print(f"{indent}{s['date']}  {s.get('label') if v is None else v}")

def test_block(t):
    # None means the write asked to skip the dry-run, not that it passed.
    if t is None:
        print("test       skipped")
        return
    if not t.get("ok"):
        print(f"test       FAILED: {t.get('error', '')}")
        return
    print(f"test       ok, {t.get('itemCount', 0)} items")
    sample_lines(t, "           ")

def desk_ids(desk):
    # desk body is {"todos": [...]}; every member is marked on the desk.
    return {t["id"] for t in (desk or {}).get("todos", [])}

def today_block(todos, active_ids, date):
    print(f"── today {date} ─────────────")
    if not todos:
        print("  (none)")
        return
    for i, t in enumerate(todos, 1):
        mark = "*" if t["id"] in active_ids else " "
        box = "[x]" if t["done"] else "[ ]"
        w = worked(t["workedSec"])
        line = f"{mark} {i} {box} {t['title']}"
        print(f"{line:<32} {w}".rstrip() if w else line)

mode = sys.argv[1]

# The "today" printed in headers is the app's day (GET /api/today, 05:00
# boundary), passed in by the caller — this formatter never reads a clock.
if mode == "overview":
    p = load(sys.argv[2]); todos = load(sys.argv[3]); overdue = load(sys.argv[4]); desk = load(sys.argv[5])
    backlog = load(sys.argv[6]); app_day = sys.argv[7]
    ids = desk_ids(desk)
    print(pomo_line(p))
    tlist = (todos or {}).get("todos", [])
    today_block(tlist, ids, app_day)
    n = len((overdue or {}).get("todos", []))
    if n:
        print(f"── overdue: {n} (dyd todo overdue)")
    b = len((backlog or {}).get("todos", []))
    if b:
        print(f"── backlog: {b} (dyd todo backlog)")

elif mode == "todo":
    todos = load(sys.argv[2]); desk = load(sys.argv[3])
    today_block((todos or {}).get("todos", []), desk_ids(desk), sys.argv[4])

elif mode == "overdue":
    overdue = load(sys.argv[2])
    ts = (overdue or {}).get("todos", [])
    if not ts:
        print("no overdue todos")
    else:
        for t in ts:
            box = "[x]" if t["done"] else "[ ]"
            print(f"  {box} {t['title']}   ({t['date']})   {t['id']}")

elif mode == "backlog":
    ts = (load(sys.argv[2]) or {}).get("todos", [])
    titles = {p["id"]: p["title"]
              for p in (load(sys.argv[3]) or {}).get("projects", [])}
    if not ts:
        print("backlog is empty")
    else:
        # The route already returns this grouped -- unfiled first, then by
        # project title -- because sort_order repeats across those lists. So
        # the inbox is exactly the b1..bk prefix, which is what makes
        # `dyd projects file b3 p2` typable. b<n> is unchanged and still
        # addresses the whole warehouse: `dyd todo move b2 today`.
        group = object()
        for i, t in enumerate(ts, 1):
            pid = t["projectId"]
            if pid != group:
                group = pid
                # An id with no project row should not occur (deleting a
                # project detaches its todos); show it rather than hide it.
                print("── " + ("inbox" if pid is None else titles.get(pid, pid))
                      + " ─────────────")
            box = "[x]" if t["done"] else "[ ]"
            w = worked(t["workedSec"])
            line = f"  b{i} {box} {t['title']}"
            print(f"{line:<32} {w}".rstrip() if w else line)

elif mode == "log":
    d = load(sys.argv[2]) or {}
    print(f"── log {d.get('day', '')} ─────────────")
    lines = d.get("lines", [])
    if not lines:
        print("  (empty)")
    else:
        for l in lines:
            # The [source] tag marks non-user writers only; direct edits are
            # the majority and tagging them would be noise.
            tag = "" if l["source"] == "user" else f"[{l['source']}] "
            print(f"  {l['time']}  {tag}{l['text']}")

elif mode == "day":
    d = load(sys.argv[2]); joined = (load(sys.argv[3]) or {}).get("todos", [])
    info = {t["id"]: t for t in joined}
    print(f"── day {d['day']} ─────────────")
    fold = d.get("fold")
    if fold:
        snap = fold["snapshot"]
        outcome = {t["id"]: t for t in snap["todos"]}
        for e in snap["entries"]:
            t = outcome.get(e["todoId"], {})
            box = "[x]" if t.get("done") else "[ ]"
            w = worked(t.get("workedSec", 0))
            line = f"  {e['start']}-{e['end']}  {box} {t.get('title', e['todoId'])}"
            print(f"{line:<40} {w}".rstrip() if w else line)
        # Involved todos the final plan never scheduled still shaped the day.
        planned = {e["todoId"] for e in snap["entries"]}
        for t in snap["todos"]:
            if t["id"] in planned:
                continue
            box = "[x]" if t["done"] else "[ ]"
            w = worked(t["workedSec"])
            line = f"  (off-plan)   {box} {t['title']}"
            print(f"{line:<40} {w}".rstrip() if w else line)
        print(f"  folded at {fold['foldedAt']}")
        if fold.get("remarks"):
            print(f"  remarks: {fold['remarks']}")
        # The evening ritual's input: the projects the day actually MOVED (time
        # banked or a todo completed), not merely the ones it was dated under.
        # Absent on a v:1 fold written before project attribution; re-folding
        # upgrades it. Omitted entirely when empty, like the overview's counts.
        moved = snap.get("projects") or []
        if moved:
            print("── projects moved ─────────────")
            wp = max(len(p["title"]) for p in moved)
            for p in moved:
                done = f"{p['doneCount']} done" if p["doneCount"] else ""
                print(f"  {p['title']:<{wp}}  {hours(p['workedSec']):<7} {done}".rstrip())
    else:
        plan = d.get("plan", [])
        if not plan:
            print("  (no plan)")
        for e in plan:
            t = info.get(e["todoId"], {})
            box = "[x]" if t.get("done") else "[ ]"
            print(f"  {e['start']}-{e['end']}  {box} {t.get('title', e['todoId'])}")
        print("  (not folded)")

elif mode == "yesterday":
    date = (load(sys.argv[2]) or {}).get("date")
    if date:
        print(f"unfolded: {date}   (dyd day {date}, dyd log {date}, dyd fold)")
    else:
        print("all days folded")

elif mode == "folded":
    f = load(sys.argv[2])["fold"]
    snap = f["snapshot"]
    done = sum(1 for t in snap["todos"] if t["done"])
    print(f"folded {snap['day']}: {len(snap['entries'])} plan entries, "
          f"{done}/{len(snap['todos'])} todos done")
    if f.get("remarks"):
        print(f"  remarks: {f['remarks']}")

elif mode == "applied":
    resp = load(sys.argv[2]); req = load(sys.argv[3]) or {}
    results = resp.get("results", [])
    print(f"applied {len(results)} op(s)   reason: {req.get('reason', '')}")
    for op, r in zip(req.get("ops", []), results):
        kind = op.get("op", "?.?")
        verb = {"create": "+", "update": "~", "delete": "-"}.get(kind.split(".")[-1], "?")
        if "todo" in r:
            t = r["todo"]; box = "[x]" if t["done"] else "[ ]"
            print(f"  {verb} todo {box} {t['title']}   ({t['date'] or 'backlog'})")
        elif "entry" in r:
            e = r["entry"]
            print(f"  {verb} plan {e['start']}-{e['end']}   ({e['day']})")
        elif "project" in r:
            p = r["project"]
            print(f"  {verb} project {p['title']}   ({p['kind']}, {p['status']})")
        elif "doc" in r:
            d = r["doc"]
            n = len([ln for ln in d["body"].splitlines() if ln.strip()])
            print(f"  {verb} doc {d['title']}   ({n} lines)")
        else:
            entity = kind.split(".")[0].replace("project_doc", "doc")
            print(f"  {verb} {entity} {r.get('deleted', '')}")

elif mode == "pomo":
    p = load(sys.argv[2])
    if p is None:
        print("pomodoro: unavailable (no widget?)")
    else:
        cycle = f"preset {p['presetId']}, {p['completedPomodoros']} done this cycle"
        print(f"phase      {phase_label(p['phase'])} ({cycle})")
        print(f"timer      {mmss(p['remainingSec'])} remaining / {mmss(p['phaseDurationSec'])}   {status_word(p)}")
        desk = p.get("desk") or []
        if not desk:
            print("desk       (none)")
        else:
            print(f"desk       {desk[0]['title']}")
            for t in desk[1:]:
                print(f"           {t['title']}")
        ot = p["overtime"]
        if ot:
            print(f"overtime   +{mmss(ot['elapsedSec'])} ({'idle' if ot['isIdle'] else 'active'})")
        if p["pendingReview"]:
            print("review     pending — confirm in the app")

elif mode in ("cmdresult", "setresult"):
    d = load(sys.argv[2]); s = d["state"]
    if not d["applied"]:
        print(f"not applied: {d.get('reason','')}")
    print(compact(s))
    if mode == "setresult" and d["applied"]:
