  project|projects) cmd_projects "$@" ;;
  log) cmd_log "$@" ;;
  day) cmd_day "$@" ;;
  yesterday) cmd_yesterday "$@" ;;
  fold) cmd_fold "$@" ;;
  apply) cmd_apply "$@" ;;
  source) cmd_source "$@" ;;
  cred) cmd_cred "$@" ;;
  -h|--help|help) die_usage ;;
